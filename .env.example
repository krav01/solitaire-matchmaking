HTTP_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://matchmaking:matchmaking@127.0.0.1:5432/matchmaking?sslmode=disable
# Generate with: openssl rand -hex 32
API_TOKEN=replace-with-at-least-32-random-characters
OUTBOX_DELIVERY_URL=https://game-backend.example.com/internal/matchmaking/events
OUTBOX_DELIVERY_TOKEN=replace-with-a-distinct-32-character-secret
DB_MAX_CONNS=10
STARTUP_TIMEOUT=10s
READINESS_TIMEOUT=2s
SHUTDOWN_TIMEOUT=10s
LOG_LEVEL=info
MATCH_WORKER_BATCH_SIZE=32
MATCH_WORKER_CONCURRENCY=8
MATCH_WORKER_LEASE=10s
MATCH_WORKER_POLL_INTERVAL=100ms
MATCH_WORKER_FAILURE_BACKOFF=1s
MATCH_WORKER_STALE_RETRY_DELAY=50ms
RESULT_DEADLINE_BATCH_SIZE=32
RESULT_DEADLINE_POLL_INTERVAL=1s
RATING_WORKER_LEASE=10s
RATING_WORKER_POLL_INTERVAL=100ms
RATING_WORKER_FAILURE_BACKOFF=1s
OUTBOX_WORKER_BATCH_SIZE=32
OUTBOX_WORKER_CONCURRENCY=8
OUTBOX_WORKER_LEASE=30s
OUTBOX_WORKER_POLL_INTERVAL=100ms
OUTBOX_REQUEST_TIMEOUT=5s
OUTBOX_RETRY_BASE_DELAY=1s
OUTBOX_RETRY_MAX_DELAY=1m
